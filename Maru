local function make(class, props, target)
    local object = Instance.new(class)
    for key, value in pairs(props) do object[key] = value end
    object.Parent = target
    return object
end
local function round(object, radius)
    make("UICorner", {CornerRadius = UDim.new(0, radius)}, object)
end
local function stroke(object, color, thickness)
    make("UIStroke", {Color = color, Thickness = thickness or 1, Transparency = 0.35}, object)
end
local function tween(object, duration, props, style)
    local t = TweenService:Create(object, TweenInfo.new(duration, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

