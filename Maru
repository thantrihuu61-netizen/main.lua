local opened, busy = false, false
local function openUI()
    if busy or opened then return end
    busy, opened = true, true
    click()
    tween(island, 0.18, {Size = UDim2.fromOffset(144,46), Position = UDim2.new(0.5,-72,0,-8)})
    task.wait(0.12)
    main.Visible = true
    mainScale.Scale = 0.78
    main.BackgroundTransparency = 0.3
    tween(mainScale, 0.32, {Scale = 1})
    tween(main, 0.24, {BackgroundTransparency = 0})
    task.wait(0.25)
    tween(island, 0.18, {Size = UDim2.fromOffset(132,44), Position = UDim2.new(0.5,-66,0,-7)})
    busy = false
end
local function closeUI()
    if busy or not opened then return end
    busy, opened = true, false
    click()
    tween(mainScale, 0.17, {Scale = 0.82})
    tween(main, 0.17, {BackgroundTransparency = 0.35})
    task.wait(0.18)
    main.Visible = false
    tween(island, 0.18, {Size = UDim2.fromOffset(132,44), Position = UDim2.new(0.5,-66,0,-7)})
    task.wait(0.18)
    busy = false
end
island.MouseButton1Click:Connect(function()
    if opened then closeUI() else openUI() end
end)

-- Drag the main window by its top title area; Dynamic Island remains fixed.
local dragging, dragStart, startPosition = false, nil, nil
content.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if input.Position.Y <= content.AbsolutePosition.Y + 48 then
            dragging, dragStart, startPosition = true, input.Position, main.Position
        end
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X, startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
end)

